@{
    ViewData["Title"] = "Campus Map";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-navy">Campus Map</h1>
        <p class="text-sm text-slate-500 mt-1">
            Find student services, support desks, and key campus locations.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- MAP -->
        <div class="lg:col-span-2 card p-0 overflow-hidden">
            <div id="map" style="height: 600px;"></div>
        </div>

        <!-- SIDEBAR -->
        <div class="card p-0 flex flex-col max-h-[600px]">
            <div class="p-4 border-b border-slate-100">
                <h2 class="font-bold text-navy">Locations</h2>
                <p class="text-xs text-slate-500 mt-0.5" id="locationCount">Loading…</p>
            </div>
            <div id="locationList" class="flex-1 overflow-y-auto p-3 space-y-2">
                <!-- Populated by JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function() {
            const locations = @Html.Raw(ViewBag.LocationsJson ?? "[]");

            // Nelson Mandela University approx center
            const DEFAULT_CENTER = [-33.9608, 25.6022];

            const map = L.map('map').setView(DEFAULT_CENTER, 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            // Custom navy marker
            const markerIcon = L.divIcon({
                className: '',
                html: '<div style="background:#0A1F44;color:#FFC72C;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3);font-size:14px;"><i class="fa-solid fa-location-dot"></i></div>',
                iconSize: [32, 32],
                iconAnchor: [16, 32]
            });

            const list = document.getElementById('locationList');
            document.getElementById('locationCount').textContent =
                locations.length + (locations.length === 1 ? ' location' : ' locations');

            if (locations.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-8">
                        <i class="fa-solid fa-map-location-dot text-3xl text-slate-200 mb-2"></i>
                        <p class="text-sm text-slate-400">No locations yet.</p>
                        <p class="text-xs text-slate-400 mt-1">Ask an admin to add some.</p>
                    </div>`;
                return;
            }

            const markers = {};

            locations.forEach(loc => {
                const marker = L.marker([loc.latitude, loc.longitude], { icon: markerIcon })
                    .addTo(map)
                    .bindPopup(`
                        <div style="font-family: inherit; min-width: 200px;">
                            <p style="font-weight: 700; color: #0A1F44; margin: 0 0 4px 0;">${loc.title}</p>
                            <p style="font-size: 11px; color: #64748b; margin: 0 0 6px 0;">
                                <i class="fa-solid fa-tag"></i> ${loc.category}
                            </p>
                            <p style="font-size: 12px; color: #334155; margin: 0 0 4px 0;">${loc.description}</p>
                            ${loc.location ? `<p style="font-size: 11px; color: #64748b; margin: 4px 0;"><i class="fa-solid fa-map-pin"></i> ${loc.location}</p>` : ''}
                            ${loc.contactPhone ? `<p style="font-size: 11px; color: #64748b; margin: 4px 0;"><i class="fa-solid fa-phone"></i> ${loc.contactPhone}</p>` : ''}
                            ${loc.contactEmail ? `<p style="font-size: 11px; color: #64748b; margin: 4px 0;"><i class="fa-solid fa-envelope"></i> ${loc.contactEmail}</p>` : ''}
                        </div>
                    `);

                markers[loc.id] = marker;

                // Sidebar list item
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'w-full text-left p-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-200';
                item.innerHTML = `
                    <div class="flex items-start gap-2">
                        <div class="w-8 h-8 rounded-lg bg-navy text-gold flex items-center justify-center shrink-0 text-xs">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="font-semibold text-sm text-navy truncate">${loc.title}</p>
                            <p class="text-xs text-slate-500 truncate">${loc.category}</p>
                            ${loc.location ? `<p class="text-[11px] text-slate-400 truncate mt-0.5">${loc.location}</p>` : ''}
                        </div>
                    </div>
                `;
                item.addEventListener('click', () => {
                    map.flyTo([loc.latitude, loc.longitude], 17, { duration: 0.6 });
                    markers[loc.id].openPopup();
                });
                list.appendChild(item);
            });
        })();
    </script>
}