@model List<NavGuru.ViewModels.EventQrCardViewModel>
@{
    ViewData["Title"] = "My QR Codes";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-navy">My Check-In QR Codes</h1>
        <p class="text-sm text-slate-500">
            Show these at the venue to check in. Each QR is unique to you and one event.
        </p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-qrcode text-4xl text-slate-200 mb-3"></i>
            <p class="font-bold text-navy">No upcoming events</p>
            <p class="text-sm text-slate-500 mt-1">
                QR codes appear here when events are scheduled.
            </p>
        </div>
    }
    else
    {
        <div id="offlineQrBanner" class="hidden mb-4">
            <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 flex items-start gap-2">
                <i class="fa-solid fa-wifi-slash mt-0.5"></i>
                <div class="flex-1">
                    <p class="font-semibold text-sm">You're offline</p>
                    <p class="text-xs mt-0.5">
                        Showing cached QR codes.
                        <span id="offlineQrCachedAt"></span>
                    </p>
                </div>
            </div>
        </div>

        <div id="qrGrid" class="grid grid-cols-1 md:grid-cols-2 gap-5">
            @foreach (var card in Model)
            {
                var isPast = card.Event.EndTime < DateTime.Now;

                <div class="card @(card.AlreadyCheckedIn ? "border-green-200 bg-green-50/30" : "")">
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                                @if (card.Event.IsMandatory)
                                {
                                    <span class="bg-navy text-gold text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                                        Required
                                    </span>
                                }
                                @if (card.AlreadyCheckedIn)
                                {
                                    <span class="bg-green-600 text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                                        <i class="fa-solid fa-check"></i> Checked in
                                    </span>
                                }
                                else if (isPast)
                                {
                                    <span class="bg-slate-200 text-slate-600 text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">
                                        Missed
                                    </span>
                                }
                            </div>
                            <h3 class="font-bold text-navy">@card.Event.Title</h3>
                            <p class="text-xs text-slate-500 mt-1">
                                <i class="fa-solid fa-clock mr-1"></i>
                                @card.Event.StartTime.ToString("ddd dd MMM · HH:mm")
                                <span class="mx-1.5">·</span>
                                <i class="fa-solid fa-location-dot mr-1"></i>
                                @card.Event.Location
                            </p>
                        </div>
                    </div>

                    <div class="text-center">
                        @if (card.AlreadyCheckedIn)
                        {
                            <div class="bg-white p-4 rounded-2xl inline-block border-2 border-green-500/30 relative">
                                <img src="@card.QrImageDataUri"
                                     alt="Checked in"
                                     class="w-44 h-44 mx-auto"
                                     style="filter: grayscale(0.4); opacity: 0.6;" />
                                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                    <div class="bg-green-600 text-white rounded-full w-16 h-16 flex items-center justify-center shadow-lg">
                                        <i class="fa-solid fa-check text-2xl"></i>
                                    </div>
                                </div>
                            </div>
                            <p class="text-xs text-green-700 font-semibold mt-3">
                                Checked in at @card.CheckedInAt?.ToLocalTime().ToString("HH:mm · dd MMM")
                            </p>
                        }
                        else
                        {
                            <div class="bg-white p-4 rounded-2xl inline-block border-2 border-navy/10">
                                <img src="@card.QrImageDataUri"
                                     alt="Check-in QR for @card.Event.Title"
                                     class="w-44 h-44 mx-auto" />
                            </div>
                            <a asp-controller="Home" asp-action="EventQr" asp-route-id="@card.Event.Id"
                               class="inline-block text-xs text-navy font-semibold hover:text-gold-dark mt-3">
                                <i class="fa-solid fa-up-right-and-down-left-from-center mr-1"></i>Open full size
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
@section Scripts {
    <script>
        (function () {
            var qrSnapshot = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(card => new
                {
                        eventId = card.Event.Id,
                        title = card.Event.Title,
                        location = card.Event.Location,
                        startTime = card.Event.StartTime.ToString("o"),
                        endTime = card.Event.EndTime.ToString("o"),
                        isMandatory = card.Event.IsMandatory,
                        qrDataUri = card.QrImageDataUri,
                        alreadyCheckedIn = card.AlreadyCheckedIn,
                        checkedInAt = card.CheckedInAt?.ToString("o")
                })));

            if (typeof NavGuruCache === 'undefined') {
                console.warn('[NavGuru] offline.js not loaded');
                return;
            }

            if (qrSnapshot.length > 0) {
                NavGuruCache.write('qr-codes', qrSnapshot);
                console.log('[NavGuru] Cached', qrSnapshot.length, 'QR codes');
            }

            if (navigator.onLine) return;

            var cache = NavGuruCache.read('qr-codes');
            var banner = document.getElementById('offlineQrBanner');
            if (banner) banner.classList.remove('hidden');

            if (!cache) {
                var at = document.getElementById('offlineQrCachedAt');
                if (at) at.textContent = 'No cached data available.';
                return;
            }

            var at2 = document.getElementById('offlineQrCachedAt');
            if (at2) at2.textContent = '(cached ' + NavGuruCache.timeAgo(cache.cachedAt) + ')';

            var container = document.getElementById('qrGrid');
            if (!container) return;

            if (!cache.data || cache.data.length === 0) {
                container.innerHTML = '<div class="card text-center py-12 col-span-2">' +
                    '<i class="fa-solid fa-qrcode text-4xl text-slate-200 mb-3"></i>' +
                    '<p class="font-bold text-navy">No cached QR codes</p>' +
                    '<p class="text-sm text-slate-500 mt-1">Reconnect to load your QR codes.</p>' +
                    '</div>';
                return;
            }

            container.innerHTML = cache.data.map(function (card) {
                var start = new Date(card.startTime);
                var dateStr = start.toLocaleDateString(undefined, { weekday: 'short', day: '2-digit', month: 'short' }) +
                    ' · ' + start.toTimeString().slice(0, 5);

                var badges = '';
                if (card.isMandatory) {
                    badges += '<span class="bg-navy text-gold text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded">Required</span>';
                }
                if (card.alreadyCheckedIn) {
                    badges += '<span class="bg-green-600 text-white text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ml-1">' +
                        '<i class="fa-solid fa-check"></i> Checked in</span>';
                }

                var qrBlock;
                if (card.alreadyCheckedIn) {
                    qrBlock = '<div class="bg-white p-4 rounded-2xl inline-block border-2 border-green-500/30 relative">' +
                        '<img src="' + card.qrDataUri + '" class="w-44 h-44 mx-auto" style="filter: grayscale(0.4); opacity: 0.6;" />' +
                        '<div class="absolute inset-0 flex items-center justify-center pointer-events-none">' +
                        '<div class="bg-green-600 text-white rounded-full w-16 h-16 flex items-center justify-center shadow-lg">' +
                        '<i class="fa-solid fa-check text-2xl"></i>' +
                        '</div>' +
                        '</div>' +
                        '</div>';
                } else {
                    qrBlock = '<div class="bg-white p-4 rounded-2xl inline-block border-2 border-navy/10">' +
                        '<img src="' + card.qrDataUri + '" class="w-44 h-44 mx-auto" />' +
                        '</div>';
                }

                return '<div class="card ' + (card.alreadyCheckedIn ? 'border-green-200 bg-green-50/30' : '') + '">' +
                    '<div class="mb-4">' +
                    '<div class="flex items-center gap-2 mb-1 flex-wrap">' + badges + '</div>' +
                    '<h3 class="font-bold text-navy">' + card.title + '</h3>' +
                    '<p class="text-xs text-slate-500 mt-1">' +
                    '<i class="fa-solid fa-clock mr-1"></i>' + dateStr +
                    '<span class="mx-1.5">·</span>' +
                    '<i class="fa-solid fa-location-dot mr-1"></i>' + card.location +
                    '</p>' +
                    '</div>' +
                    '<div class="text-center">' + qrBlock + '</div>' +
                    '</div>';
            }).join('');

            console.log('[NavGuru] Rendered', cache.data.length, 'QR codes from cache');
        })();
    </script>
}