@model List<NavGuru.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var grouped = Model.GroupBy(n => n.CreatedAt.Date).OrderByDescending(g => g.Key);
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-navy">Notifications</h1>
        <p class="text-sm text-slate-500">@Model.Count total</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-bell-slash text-4xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-500">You're all caught up.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var day in grouped)
            {
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
                        @(day.Key == DateTime.Today ? "Today"
                          : day.Key == DateTime.Today.AddDays(-1) ? "Yesterday"
                          : day.Key.ToString("dddd, dd MMMM"))
                    </p>
                    <div class="space-y-2">
                        @foreach (var n in day)
                        {
                            <div class="card flex items-start gap-3">
                                <div class="w-9 h-9 rounded-full bg-gold/20 text-gold-dark flex items-center justify-center shrink-0">
                                    <i class="fa-solid fa-bell"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-navy text-sm">@n.Title</p>
                                    <p class="text-sm text-slate-600 mt-1">@n.Message</p>
                                    <p class="text-[11px] text-slate-400 mt-1.5">
                                        @n.CreatedAt.ToLocalTime().ToString("HH:mm")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>