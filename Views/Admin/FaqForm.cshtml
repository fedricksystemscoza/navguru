@model NavGuru.ViewModels.Admin.FaqFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit FAQ" : "New FAQ";
    var categories = new[] { "Admin", "IT", "Academic", "Campus", "Support", "Finance", "Social", "General" };
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Faqs" class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to FAQs
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-6">
        @(isEdit ? "Edit FAQ" : "Create New FAQ")
    </h1>

    <form asp-action="@(isEdit ? "EditFaq" : "CreateFaq")" method="post" class="card space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs"></div>

        <div>
            <label asp-for="Question" class="text-xs font-semibold text-navy"></label>
            <input asp-for="Question" placeholder="e.g. Where do I get my student card?"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="Question" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Answer" class="text-xs font-semibold text-navy"></label>
            <textarea asp-for="Answer" rows="5" placeholder="Give a clear, complete answer..."
                      class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold"></textarea>
            <span asp-validation-for="Answer" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Category" class="text-xs font-semibold text-navy"></label>
            <select asp-for="Category"
                    class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold">
                @foreach (var c in categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <span asp-validation-for="Category" class="text-red-600 text-xs"></span>
        </div>

        <label class="flex items-start gap-2 cursor-pointer p-3 rounded-lg bg-slate-50">
            <input asp-for="IsApproved" type="checkbox" class="mt-0.5 rounded" />
            <div>
                <span class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.IsApproved)</span>
                <p class="text-xs text-slate-500 mt-0.5">
                    Only approved entries are shown to students and used by the AI assistant.
                </p>
            </div>
        </label>

        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
            <a asp-action="Faqs"
               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                @(isEdit ? "Save Changes" : "Create FAQ")
            </button>
        </div>
    </form>
</div>