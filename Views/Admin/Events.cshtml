@model List<NavGuru.Models.OrientationEvent>
@{
    ViewData["Title"] = "Events";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="flex items-center justify-between mb-6">
        <div>
            <a asp-controller="Admin" asp-action="Index"
               class="text-xs font-semibold text-slate-500 hover:text-navy">
                <i class="fa-solid fa-arrow-left mr-1"></i> Back to dashboard
            </a>
            <h1 class="text-2xl font-bold text-navy mt-2">Orientation Events</h1>
            <p class="text-sm text-slate-500">@Model.Count event@(Model.Count == 1 ? "" : "s") scheduled</p>
        </div>
    </div>

    <div class="space-y-3">
        @foreach (var ev in Model)
        {
            <div class="card flex items-start gap-4">
                <div class="w-14 h-14 rounded-xl bg-navy text-white flex flex-col items-center justify-center shrink-0">
                    <span class="text-[10px] uppercase opacity-80">@ev.StartTime.ToString("MMM")</span>
                    <span class="text-lg font-bold leading-none">@ev.StartTime.ToString("dd")</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h3 class="font-bold text-navy truncate">@ev.Title</h3>
                            <p class="text-xs text-slate-500 mt-1">
                                <i class="fa-solid fa-clock mr-1"></i>
                                @ev.StartTime.ToString("ddd dd MMM · HH:mm") – @ev.EndTime.ToString("HH:mm")
                                <span class="mx-1.5">·</span>
                                <i class="fa-solid fa-location-dot mr-1"></i>@ev.Location
                            </p>
                            <p class="text-sm text-slate-600 mt-2">@ev.Description</p>
                        </div>
                        @if (ev.IsMandatory)
                        {
                            <span class="badge badge-navy shrink-0">Required</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>