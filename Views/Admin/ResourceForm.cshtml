@model NavGuru.ViewModels.Admin.ResourceFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Resource" : "New Resource";
    var categories = new[] { "Mental Health", "Academic", "IT", "Finance", "Health", "Safety", "Career", "General" };
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Resources" class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to resources
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-6">
        @(isEdit ? "Edit Resource" : "Create New Resource")
    </h1>

    <form asp-action="@(isEdit ? "EditResource" : "CreateResource")" method="post" class="card space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs"></div>

        <div>
            <label asp-for="Title" class="text-xs font-semibold text-navy"></label>
            <input asp-for="Title" placeholder="e.g. Student Counselling Services"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="Title" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Description" class="text-xs font-semibold text-navy"></label>
            <textarea asp-for="Description" rows="3"
                      placeholder="Describe what the resource offers and when students should use it..."
                      class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold"></textarea>
            <span asp-validation-for="Description" class="text-red-600 text-xs"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Category" class="text-xs font-semibold text-navy"></label>
                <select asp-for="Category"
                        class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold">
                    @foreach (var c in categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="Order" class="text-xs font-semibold text-navy"></label>
                <input asp-for="Order" type="number" min="0"
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="ContactEmail" class="text-xs font-semibold text-navy"></label>
                <input asp-for="ContactEmail" type="email" placeholder="help@mandela.ac.za"
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
                <span asp-validation-for="ContactEmail" class="text-red-600 text-xs"></span>
            </div>
            <div>
                <label asp-for="ContactPhone" class="text-xs font-semibold text-navy"></label>
                <input asp-for="ContactPhone" placeholder="+27 41 504 1111"
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Location" class="text-xs font-semibold text-navy"></label>
                <input asp-for="Location" placeholder="Building 12, South Campus"
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            </div>
            <div>
                <label asp-for="Url" class="text-xs font-semibold text-navy"></label>
                <input asp-for="Url" type="url" placeholder="https://..."
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
                <span asp-validation-for="Url" class="text-red-600 text-xs"></span>
            </div>
        </div>

        <label class="flex items-start gap-2 cursor-pointer p-3 rounded-lg bg-slate-50">
            <input asp-for="IsActive" type="checkbox" class="mt-0.5 rounded" />
            <div>
                <span class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.IsActive)</span>
                <p class="text-xs text-slate-500 mt-0.5">
                    Inactive resources are hidden from students but kept in the system.
                </p>
            </div>
        </label>

        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
            <a asp-action="Resources"
               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                @(isEdit ? "Save Changes" : "Create Resource")
            </button>
        </div>
    </form>
</div>