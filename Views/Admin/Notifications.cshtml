@model List<NavGuru.Models.Notification>
@{
    ViewData["Title"] = "Manage Notifications";
    var grouped = Model
        .GroupBy(n => new { n.Title, n.Message, Date = n.CreatedAt.Date, Hour = n.CreatedAt.Hour, Minute = n.CreatedAt.Minute })
        .OrderByDescending(g => g.Max(n => n.CreatedAt))
        .ToList();
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage Notifications</h1>
            <p class="text-sm text-slate-500">
                @Model.Count total deliver@(Model.Count == 1 ? "y" : "ies")
                · @grouped.Count unique broadcast@(grouped.Count == 1 ? "" : "s")
            </p>
        </div>
        <a asp-action="CreateNotification"
           class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition whitespace-nowrap">
            <i class="fa-solid fa-bullhorn mr-1"></i> New Notification
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    @if (grouped.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-bell text-4xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-500">No notifications yet.</p>
            <p class="text-xs text-slate-400 mt-1">Broadcasts appear instantly on student dashboards.</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var group in grouped)
            {
                var first = group.First();
                var recipients = group.Count();
                var readCount = group.Count(n => n.IsRead);
                var sampleId = first.Id;

                <div class="card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1 flex-wrap">
                                <h3 class="font-bold text-navy text-sm">@first.Title</h3>
                                @if (recipients > 1)
                                {
                                    <span class="badge badge-navy">Broadcast · @recipients students</span>
                                }
                                else
                                {
                                    <span class="badge badge-slate">Single</span>
                                }
                            </div>
                            <p class="text-sm text-slate-600">@first.Message</p>
                            <div class="flex items-center gap-3 mt-2 text-xs text-slate-400">
                                <span><i class="fa-solid fa-clock mr-1"></i>@first.CreatedAt.ToLocalTime().ToString("ddd dd MMM · HH:mm")</span>
                                @if (recipients > 1)
                                {
                                    <span><i class="fa-solid fa-envelope-open mr-1"></i>@readCount/@recipients read</span>
                                }
                            </div>
                        </div>
                        <form asp-action="DeleteNotificationGroup" asp-route-id="@sampleId" method="post"
                              onsubmit="return confirm('Delete this notification@(recipients > 1 ? " (all " + recipients + " copies)" : "")?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="text-xs font-semibold text-red-600 hover:bg-red-50 px-2 py-1 rounded-lg border border-red-200 shrink-0">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>