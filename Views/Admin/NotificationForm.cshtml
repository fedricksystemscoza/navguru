@model NavGuru.ViewModels.Admin.NotificationFormViewModel
@{
    ViewData["Title"] = "New Notification";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Notifications" class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to notifications
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-1">Send a Notification</h1>
    <p class="text-sm text-slate-500 mb-6">
        Broadcasts appear immediately on student dashboards and bell icons.
    </p>

    <form asp-action="CreateNotification" method="post" class="card space-y-4">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs"></div>

        <div>
            <label asp-for="Title" class="text-xs font-semibold text-navy"></label>
            <input asp-for="Title" placeholder="e.g. Library closing early today"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="Title" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="Message" class="text-xs font-semibold text-navy"></label>
            <textarea asp-for="Message" rows="4"
                      placeholder="Write a short, clear message..."
                      class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold"></textarea>
            <span asp-validation-for="Message" class="text-red-600 text-xs"></span>
        </div>

        <label class="flex items-start gap-2 cursor-pointer p-3 rounded-lg bg-slate-50">
            <input asp-for="Broadcast" type="checkbox" class="mt-0.5 rounded" />
            <div>
                <span class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.Broadcast)</span>
                <p class="text-xs text-slate-500 mt-0.5">
                    Sends a copy to every student in the system.
                </p>
            </div>
        </label>

        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
            <a asp-action="Notifications"
               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                <i class="fa-solid fa-paper-plane mr-1"></i> Send
            </button>
        </div>
    </form>
</div>