@model List<NavGuru.Models.FaqEntry>
@{
    ViewData["Title"] = "Manage FAQs";
    var grouped = Model.GroupBy(f => f.Category).OrderBy(g => g.Key);
    var totalApproved = Model.Count(f => f.IsApproved);
    var totalPending = Model.Count - totalApproved;
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage FAQ Data</h1>
            <p class="text-sm text-slate-500">
                @Model.Count total · @totalApproved approved · @totalPending pending
            </p>
            <p class="text-xs text-slate-400 mt-1">
                <i class="fa-solid fa-circle-info mr-1"></i>
                The AI assistant answers only from <strong>approved</strong> entries.
            </p>
        </div>
        <a asp-action="CreateFaq"
           class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition whitespace-nowrap">
            <i class="fa-solid fa-plus mr-1"></i> New FAQ
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-circle-question text-4xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-500">No FAQs yet. Add your first one.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var group in grouped)
            {
                <div>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
                        <i class="fa-solid fa-tag mr-1"></i>@group.Key
                        <span class="text-slate-400 font-normal ml-1">(@group.Count())</span>
                    </h2>
                    <div class="space-y-2">
                        @foreach (var faq in group)
                        {
                            <div class="card">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1">
                                            <p class="font-semibold text-navy text-sm">@faq.Question</p>
                                            @if (faq.IsApproved)
                                            {
                                                <span class="badge badge-gold shrink-0">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-slate shrink-0">Pending</span>
                                            }
                                        </div>
                                        <p class="text-sm text-slate-600">@faq.Answer</p>
                                    </div>
                                    <div class="flex flex-col gap-2 shrink-0">
                                        <a asp-action="EditFaq" asp-route-id="@faq.Id"
                                           class="text-xs font-semibold text-navy hover:text-gold-dark px-3 py-1.5 rounded-lg border border-slate-200 hover:border-navy whitespace-nowrap">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteFaq" asp-route-id="@faq.Id" method="post"
                                              onsubmit="return confirm('Delete this FAQ?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="text-xs font-semibold text-red-600 hover:bg-red-50 px-3 py-1.5 rounded-lg border border-red-200 w-full">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>