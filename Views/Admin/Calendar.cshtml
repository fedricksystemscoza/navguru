@model List<NavGuru.Models.OrientationEvent>
@{
    ViewData["Title"] = "Manage Campus Calendar";
    var now = DateTime.Now;
    var grouped = Model.GroupBy(e => e.StartTime.Date).OrderBy(g => g.Key);
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage Campus Calendar</h1>
            <p class="text-sm text-slate-500">
                @Model.Count event@(Model.Count == 1 ? "" : "s") scheduled
            </p>
        </div>
        <div class="flex gap-2">
            <a asp-action="Orientations"
               class="px-4 py-2.5 rounded-xl text-sm font-semibold border border-slate-200 hover:border-navy text-navy transition whitespace-nowrap">
                <i class="fa-solid fa-list mr-1"></i> List view
            </a>
            <a asp-action="CreateEvent"
               class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition whitespace-nowrap">
                <i class="fa-solid fa-plus mr-1"></i> New Event
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-calendar-days text-4xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-500">No events on the calendar.</p>
        </div>
    }
    else
    {
        <div class="space-y-8">
            @foreach (var day in grouped)
            {
                var isToday = day.Key.Date == now.Date;
                var isPast = day.Key.Date < now.Date;

                <div>
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-14 h-14 rounded-xl @(isToday ? "bg-gold text-navy" : isPast ? "bg-slate-200 text-slate-500" : "bg-navy text-white") flex flex-col items-center justify-center shrink-0">
                            <span class="text-[10px] uppercase opacity-80">@day.Key.ToString("MMM")</span>
                            <span class="text-lg font-bold leading-none">@day.Key.ToString("dd")</span>
                        </div>
                        <div>
                            <p class="font-bold text-navy">
                                @day.Key.ToString("dddd, dd MMMM yyyy")
                                @if (isToday)
                                {
                                    <span class="badge badge-gold ml-2">Today</span>
                                }
                            </p>
                            <p class="text-xs text-slate-500">
                                @day.Count() event@(day.Count() == 1 ? "" : "s")
                            </p>
                        </div>
                    </div>

                    <div class="space-y-2 ml-2 sm:ml-20">
                        @foreach (var ev in day.OrderBy(e => e.StartTime))
                        {
                            <div class="card flex items-start gap-4">
                                <div class="w-1 self-stretch rounded-full @(ev.IsMandatory ? "bg-gold" : "bg-navy")"></div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <h3 class="font-bold text-navy truncate text-sm">@ev.Title</h3>
                                            <p class="text-xs text-slate-500 mt-1">
                                                <i class="fa-solid fa-clock mr-1"></i>@ev.StartTime.ToString("HH:mm")–@ev.EndTime.ToString("HH:mm")
                                                <span class="mx-1.5">·</span>
                                                <i class="fa-solid fa-location-dot mr-1"></i>@ev.Location
                                            </p>
                                        </div>
                                        <div class="flex flex-col items-end gap-2 shrink-0">
                                            @if (ev.IsMandatory)
                                            {
                                                <span class="badge badge-navy">Required</span>
                                            }
                                            <div class="flex gap-1">
                                                <a asp-action="EditEvent" asp-route-id="@ev.Id"
                                                   class="text-xs text-navy hover:text-gold-dark px-2 py-1 rounded-lg border border-slate-200 hover:border-navy">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post"
                                                      onsubmit="return confirm('Delete &quot;@ev.Title&quot;?');"
                                                      class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="text-xs text-red-600 hover:bg-red-50 px-2 py-1 rounded-lg border border-red-200">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>