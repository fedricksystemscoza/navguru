@model List<NavGuru.Models.OrientationEvent>
@{
    ViewData["Title"] = "Manage Orientations";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage Orientations</h1>
            <p class="text-sm text-slate-500">@Model.Count event@(Model.Count == 1 ? "" : "s")</p>
        </div>
        <a asp-action="CreateEvent"
           class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition">
            <i class="fa-solid fa-plus mr-1"></i> New Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    <div class="space-y-3">
        @foreach (var ev in Model)
        {
            <div class="card flex items-start gap-4">
                <div class="w-14 h-14 rounded-xl bg-navy text-white flex flex-col items-center justify-center shrink-0">
                    <span class="text-[10px] uppercase opacity-80">@ev.StartTime.ToString("MMM")</span>
                    <span class="text-lg font-bold leading-none">@ev.StartTime.ToString("dd")</span>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h3 class="font-bold text-navy truncate">@ev.Title</h3>
                            <p class="text-xs text-slate-500 mt-1">
                                <i class="fa-solid fa-clock mr-1"></i>@ev.StartTime.ToString("HH:mm")–@ev.EndTime.ToString("HH:mm")
                                <span class="mx-1.5">·</span>
                                <i class="fa-solid fa-location-dot mr-1"></i>@ev.Location
                            </p>
                            <p class="text-sm text-slate-600 mt-1.5 line-clamp-2">@ev.Description</p>
                        </div>
                        <div class="flex flex-col items-end gap-2 shrink-0">
                            @if (ev.IsMandatory)
                            {
                                <span class="badge badge-navy">Required</span>
                            }
                            <div class="flex gap-2">
                                <a asp-controller="CheckIn" asp-action="Display" asp-route-id="@ev.Id"
                                   class="text-xs font-semibold text-white bg-navy hover:bg-navy-light px-2 py-1 rounded-lg">
                                    <i class="fa-solid fa-qrcode"></i> Show QR
                                </a>
                                <a asp-action="EditEvent" asp-route-id="@ev.Id"
                                   class="text-xs font-semibold text-navy hover:text-gold-dark px-2 py-1 rounded-lg border border-slate-200 hover:border-navy">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.Id" method="post"
                                      onsubmit="return confirm('Delete &quot;@ev.Title&quot;?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="text-xs font-semibold text-red-600 hover:bg-red-50 px-2 py-1 rounded-lg border border-red-200">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>