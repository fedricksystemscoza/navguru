@model List<NavGuru.Models.SupportResource>
@{
    ViewData["Title"] = "Manage Support Resources";
    var grouped = Model.GroupBy(r => r.Category).OrderBy(g => g.Key);
    var active = Model.Count(r => r.IsActive);
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage Student Support Resources</h1>
            <p class="text-sm text-slate-500">
                @Model.Count total · @active active
            </p>
            <p class="text-xs text-slate-400 mt-1">
                <i class="fa-solid fa-circle-info mr-1"></i>
                Resources appear on the student dashboard and support pages.
            </p>
        </div>
        <a asp-action="CreateResource"
           class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition whitespace-nowrap">
            <i class="fa-solid fa-plus mr-1"></i> New Resource
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-hand-holding-heart text-4xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-500">No resources yet.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var group in grouped)
            {
                <div>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
                        <i class="fa-solid fa-tag mr-1"></i>@group.Key
                        <span class="text-slate-400 font-normal ml-1">(@group.Count())</span>
                    </h2>
                    <div class="space-y-2">
                        @foreach (var r in group)
                        {
                            <div class="card">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                                            <h3 class="font-bold text-navy text-sm">@r.Title</h3>
                                            @if (!r.IsActive)
                                            {
                                                <span class="badge badge-slate">Inactive</span>
                                            }
                                        </div>
                                        <p class="text-sm text-slate-600">@r.Description</p>

                                        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs text-slate-500">
                                            @if (!string.IsNullOrEmpty(r.ContactEmail))
                                            {
                                                <span><i class="fa-solid fa-envelope mr-1"></i>@r.ContactEmail</span>
                                            }
                                            @if (!string.IsNullOrEmpty(r.ContactPhone))
                                            {
                                                <span><i class="fa-solid fa-phone mr-1"></i>@r.ContactPhone</span>
                                            }
                                            @if (!string.IsNullOrEmpty(r.Location))
                                            {
                                                <span><i class="fa-solid fa-location-dot mr-1"></i>@r.Location</span>
                                            }
                                            @if (!string.IsNullOrEmpty(r.Url))
                                            {
                                                <a href="@r.Url" target="_blank" class="text-navy font-semibold hover:text-gold-dark">
                                                    <i class="fa-solid fa-external-link-alt mr-1"></i>Visit
                                                </a>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-2 shrink-0">
                                        <a asp-action="EditResource" asp-route-id="@r.Id"
                                           class="text-xs font-semibold text-navy hover:text-gold-dark px-3 py-1.5 rounded-lg border border-slate-200 hover:border-navy whitespace-nowrap">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteResource" asp-route-id="@r.Id" method="post"
                                              onsubmit="return confirm('Delete &quot;@r.Title&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="text-xs font-semibold text-red-600 hover:bg-red-50 px-3 py-1.5 rounded-lg border border-red-200 w-full">
                                                <i class="fa-solid fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>