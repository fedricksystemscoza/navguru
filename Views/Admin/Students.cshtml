@model List<NavGuru.ViewModels.AdminStudentViewModel>
@{
    ViewData["Title"] = "Manage Students";
    var studentCount = Model.Count(s => !s.IsAdmin);
    var adminCount = Model.Count(s => s.IsAdmin);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="Admin" asp-action="Index"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Admin home
    </a>

    <div class="flex items-center justify-between mt-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-navy">Manage Student Accounts</h1>
            <p class="text-sm text-slate-500">
                @studentCount student@(studentCount == 1 ? "" : "s")
                @if (adminCount > 0)
                {
                    <span> · @adminCount admin@(adminCount == 1 ? "" : "s")</span>
                }
            </p>
        </div>
        <a asp-action="CreateStudent"
           class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2.5 rounded-xl text-sm transition whitespace-nowrap">
            <i class="fa-solid fa-user-plus mr-1"></i> Add User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-check-circle mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3 mb-4">
            <i class="fa-solid fa-circle-exclamation mr-1"></i> @TempData["Error"]
        </div>
    }

    <div class="card overflow-hidden p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-12">
                <i class="fa-solid fa-users text-4xl text-slate-200 mb-3"></i>
                <p class="text-sm text-slate-500">No accounts yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 border-b border-slate-100">
                        <tr>
                            <th class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider px-6 py-3">User</th>
                            <th class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider px-4 py-3">Student #</th>
                            <th class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider px-4 py-3">Faculty</th>
                            <th class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider px-4 py-3">Role</th>
                            <th class="text-right text-xs font-bold text-slate-500 uppercase tracking-wider px-6 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50 transition">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-navy text-gold font-bold flex items-center justify-center text-xs shrink-0">
                                            @(string.IsNullOrEmpty(s.FullName) ? "?" : string.Join("", s.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpper())
                                        </div>
                                        <div class="min-w-0">
                                            <p class="font-semibold text-sm text-navy truncate">@s.FullName</p>
                                            <p class="text-xs text-slate-500 truncate">@s.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-700">
                                    @(string.IsNullOrEmpty(s.StudentNumber) ? "—" : s.StudentNumber)
                                </td>
                                <td class="px-4 py-4 text-sm text-slate-700">
                                    @(string.IsNullOrEmpty(s.Faculty) ? "—" : s.Faculty)
                                </td>
                                <td class="px-4 py-4">
                                    @if (s.IsAdmin)
                                    {
                                        <span class="badge badge-navy">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-slate">Student</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <a asp-action="EditStudent" asp-route-id="@s.Id"
                                           class="text-xs font-semibold text-navy hover:text-gold-dark px-2 py-1 rounded-lg border border-slate-200 hover:border-navy">
                                            <i class="fa-solid fa-pen"></i> Edit
                                        </a>
                                        <form asp-action="DeleteStudent" asp-route-id="@s.Id" method="post"
                                              onsubmit="return confirm('Delete @s.FullName? This removes their checklist and check-in data too.');"
                                              class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="text-xs font-semibold text-red-600 hover:bg-red-50 px-2 py-1 rounded-lg border border-red-200">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>