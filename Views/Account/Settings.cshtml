@model NavGuru.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Profile" class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to profile
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-1">Settings</h1>
    <p class="text-sm text-slate-500 mb-6">Customize your NavGuru experience.</p>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl px-4 py-3 mb-4">
            <i class="fa-solid fa-circle-check mr-1"></i> @TempData["Success"]
        </div>
    }

    <form asp-action="Settings" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <!-- APPEARANCE -->
        @* <div class="card">
            <h2 class="font-bold text-navy mb-1">
                <i class="fa-solid fa-palette mr-1.5"></i>Appearance
            </h2>
            <p class="text-xs text-slate-500 mb-4">How NavGuru looks for you.</p>

          @*   <label class="flex items-center justify-between gap-3 cursor-pointer">
                <div>
                    <p class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.DarkMode)</p>
                    <p class="text-xs text-slate-500">Use a dark color scheme across the app.</p>
                </div>
                <input asp-for="DarkMode" type="checkbox" class="w-11 h-6 rounded-full appearance-none bg-slate-200 checked:bg-gold relative transition cursor-pointer before:content-[''] before:absolute before:w-5 before:h-5 before:rounded-full before:bg-white before:top-0.5 before:left-0.5 before:transition checked:before:translate-x-5" />
            </label> 
        </div> *@

        <!-- NOTIFICATIONS -->
        <div class="card">
            <h2 class="font-bold text-navy mb-1">
                <i class="fa-solid fa-bell mr-1.5"></i>Notifications
            </h2>
            <p class="text-xs text-slate-500 mb-4">Choose how you want to be notified.</p>

            <div class="space-y-3">
                <label class="flex items-center justify-between gap-3 cursor-pointer">
                    <div>
                        <p class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.EmailNotifications)</p>
                        <p class="text-xs text-slate-500">Receive orientation updates via email.</p>
                    </div>
                    <input asp-for="EmailNotifications" type="checkbox" class="w-11 h-6 rounded-full appearance-none bg-slate-200 checked:bg-gold relative transition cursor-pointer before:content-[''] before:absolute before:w-5 before:h-5 before:rounded-full before:bg-white before:top-0.5 before:left-0.5 before:transition checked:before:translate-x-5" />
                </label>

                <label class="flex items-center justify-between gap-3 cursor-pointer">
                    <div>
                        <p class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.PushNotifications)</p>
                        <p class="text-xs text-slate-500">Browser notifications for new announcements.</p>
                    </div>
                    <input asp-for="PushNotifications" type="checkbox" class="w-11 h-6 rounded-full appearance-none bg-slate-200 checked:bg-gold relative transition cursor-pointer before:content-[''] before:absolute before:w-5 before:h-5 before:rounded-full before:bg-white before:top-0.5 before:left-0.5 before:transition checked:before:translate-x-5" />
                </label>

                <label class="flex items-center justify-between gap-3 cursor-pointer">
                    <div>
                        <p class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.EventReminders)</p>
                        <p class="text-xs text-slate-500">Remind me 15 minutes before an event starts.</p>
                    </div>
                    <input asp-for="EventReminders" type="checkbox" class="w-11 h-6 rounded-full appearance-none bg-slate-200 checked:bg-gold relative transition cursor-pointer before:content-[''] before:absolute before:w-5 before:h-5 before:rounded-full before:bg-white before:top-0.5 before:left-0.5 before:transition checked:before:translate-x-5" />
                </label>
            </div>
        </div>

        <!-- LANGUAGE -->
     @*    <div class="card">
            <h2 class="font-bold text-navy mb-1">
                <i class="fa-solid fa-language mr-1.5"></i>Language
            </h2>
            <p class="text-xs text-slate-500 mb-4">Preferred language for content.</p>

            <select asp-for="Language"
                    class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold">
                <option value="en">English</option>
                <option value="af">Afrikaans</option>
                <option value="xh">isiXhosa</option>
                <option value="zu">isiZulu</option>
            </select>
        </div> *@

        <!-- OFFLINE -->
        <div class="card">
            <h2 class="font-bold text-navy mb-1">
                <i class="fa-solid fa-cloud-arrow-down mr-1.5"></i>Offline &amp; Data
            </h2>
            <p class="text-xs text-slate-500 mb-4">Control cached content for offline use.</p>

            <label class="flex items-center justify-between gap-3 cursor-pointer mb-4">
                <div>
                    <p class="text-sm font-semibold text-navy">@Html.DisplayNameFor(m => m.OfflineCacheEnabled)</p>
                    <p class="text-xs text-slate-500">Cache events and FAQs for offline viewing.</p>
                </div>
                <input asp-for="OfflineCacheEnabled" type="checkbox" class="w-11 h-6 rounded-full appearance-none bg-slate-200 checked:bg-gold relative transition cursor-pointer before:content-[''] before:absolute before:w-5 before:h-5 before:rounded-full before:bg-white before:top-0.5 before:left-0.5 before:transition checked:before:translate-x-5" />
            </label>

            <div class="border-t border-slate-100 pt-4 flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-navy">Clear offline cache</p>
                    <p class="text-xs text-slate-500">Remove cached events and FAQs from this device.</p>
                </div>
                <button type="submit" formaction="@Url.Action("ClearCache", "Account")"
                        class="text-xs font-semibold text-navy hover:text-gold-dark px-3 py-1.5 rounded-lg border border-slate-200 hover:border-navy">
                    Clear Cache
                </button>
            </div>
        </div>

        <!-- SAVE -->
        <div class="flex justify-end gap-2">
            <a asp-action="Profile"
               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                Save Settings
            </button>
        </div>
    </form>

    <!-- DANGER ZONE -->
    <div class="card border-red-200 mt-8">
        <h2 class="font-bold text-red-600 mb-1">
            <i class="fa-solid fa-triangle-exclamation mr-1.5"></i>Danger Zone
        </h2>
        <p class="text-xs text-slate-500 mb-4">Irreversible actions — proceed with caution.</p>

        <form asp-action="DeleteAccount" method="post"
              onsubmit="return confirm('Permanently delete your account? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="text-sm font-bold text-red-600 hover:bg-red-50 px-4 py-2 rounded-lg border border-red-200">
                <i class="fa-solid fa-trash mr-1"></i> Delete my account
            </button>
        </form>
    </div>
</div>