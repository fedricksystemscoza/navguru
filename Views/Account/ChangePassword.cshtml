@model NavGuru.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-action="Profile" class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to profile
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-6">Change Password</h1>

    <form asp-action="ChangePassword" method="post" class="card space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs"></div>

        <div>
            <label asp-for="CurrentPassword" class="text-xs font-semibold text-navy"></label>
            <input asp-for="CurrentPassword"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="CurrentPassword" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="text-xs font-semibold text-navy"></label>
            <input asp-for="NewPassword"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="NewPassword" class="text-red-600 text-xs"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="text-xs font-semibold text-navy"></label>
            <input asp-for="ConfirmPassword"
                   class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs"></span>
        </div>

        <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
            <a asp-action="Profile"
               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100">
                Cancel
            </a>
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                Change Password
            </button>
        </div>
    </form>
</div>