@{
    ViewData["Title"] = "Log In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <title>Log In - NavGuru</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
            tailwind.config = {
                theme: { extend: { colors: {
                    navy: { DEFAULT: '#0A1F44', light: '#132B5C' },
                    gold: { DEFAULT: '#FFC72C', dark: '#E0A800' }
                }}}
            }
    </script>
</head>
<body class="h-full bg-white flex items-center justify-center p-4">
    <div class="fixed top-0 left-0 right-0 h-1.5 bg-navy"></div>

    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-8 space-y-6">

            <!-- LOGO -->
            <div class="text-center">
                <img src="~/images/navbuddy-logo.png" alt="NavGuru"
                     class="h-16 w-16 mx-auto mb-3 rounded-xl object-contain"
                     onerror="this.style.display='none';document.getElementById('logoFallback').style.display='flex';" />
                <div id="logoFallback"
                     class="hidden bg-navy text-gold w-16 h-16 rounded-xl items-center justify-center mx-auto mb-3 text-2xl">
                    <i class="fa-solid fa-compass"></i>
                </div>
                <h1 class="text-2xl font-bold text-navy">NavBuddy</h1>
                <p class="text-xs text-slate-500 mt-1">Student Orientation &amp; Support Portal</p>
            </div>

            <!-- VALIDATION -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 border border-red-200 text-red-700 text-xs font-semibold px-3 py-2 rounded-lg">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i> Invalid login attempt.
                </div>
            }

            <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="MicrosoftEntra" />
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <button type="submit"
                        class="w-full flex items-center justify-center gap-2 bg-navy hover:bg-navy-light text-white font-semibold py-2.5 rounded-xl text-sm transition">
                    <svg width="18" height="18" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                        <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                        <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                    </svg>
                    Continue with Microsoft 365
                </button>
            </form>
            <p class="text-[11px] text-slate-500 text-center -mt-2">
                Use your <span class="font-semibold text-navy">microsoft account</span> account
            </p>

            <div class="relative">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
                <div class="relative flex justify-center text-[11px]">
                    <span class="bg-white px-2 text-slate-400">or sign in with email</span>
                </div>
            </div>

            <!-- EMAIL/PASSWORD FORM -->
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div>
                    <label class="text-xs font-semibold text-navy">Email</label>
                    <input type="email" name="email" required placeholder="you@NavGuru.edu"
                           class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-navy">Password</label>
                    <input type="password" name="password" required placeholder="••••••••"
                           class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm
                    focus:outline-none focus:ring-2 focus:ring-gold focus:border-gold" />
                </div>
                <button type="submit"
                        class="w-full bg-gold hover:bg-gold-dark text-navy font-bold py-2.5 rounded-xl text-sm transition">
                    Log In
                </button>
            </form>

            <!-- DEMO CREDENTIALS -->
           @*  <div class="text-[11px] text-slate-400 text-center border-t border-slate-100 pt-4 leading-relaxed">
                <span class="font-semibold text-slate-500">Demo accounts</span><br />
                Student: alex.smith@NavGuru.edu / Passw0rd!<br />
                Admin: sarah.jenkins@NavGuru.edu / Passw0rd!
            </div> *@
        </div>
        <p class="text-center text-[11px] text-slate-400 mt-4">
            © @DateTime.Now.Year NavBuddy · Nelson Mandela University
        </p>
    </div>
</body>
</html>