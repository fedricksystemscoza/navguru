@model NavGuru.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-navy">My Profile</h1>
        <p class="text-sm text-slate-500">
            Member since @Model.CreatedAt.ToString("dd MMM yyyy")
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl px-4 py-3 mb-4">
            <i class="fa-solid fa-circle-check mr-1"></i> @TempData["Success"]
        </div>
    }

    <div class="card mb-6">
        <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-100">
            <div class="w-14 h-14 rounded-full bg-navy text-gold flex items-center justify-center text-lg font-bold">
                @{
                    var parts = (Model.FullName ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var initials = string.Join("", parts.Take(2).Select(s => s[0])).ToUpper();
                }
                @initials
            </div>
            <div>
                <p class="font-bold text-navy">@Model.FullName</p>
                <p class="text-xs text-slate-500">@Model.RoleName</p>
            </div>
        </div>

        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
            <i class="fa-solid fa-lock mr-1"></i>Identity (managed by admin)
        </h2>

        <div class="space-y-3">
            <div>
                <label class="text-xs font-semibold text-navy">Full Name</label>
                <div class="mt-1 w-full border border-slate-200 bg-slate-50 rounded-lg px-3 py-2 text-sm text-slate-600 flex items-center justify-between">
                    <span>@Model.FullName</span>
                    <i class="fa-solid fa-lock text-slate-400 text-xs" title="Contact admin to change"></i>
                </div>
            </div>

            <div>
                <label class="text-xs font-semibold text-navy">Student Number</label>
                <div class="mt-1 w-full border border-slate-200 bg-slate-50 rounded-lg px-3 py-2 text-sm text-slate-600 flex items-center justify-between font-mono">
                    <span>@(Model.StudentNumber ?? "—")</span>
                    <i class="fa-solid fa-lock text-slate-400 text-xs" title="Contact admin to change"></i>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Assigned automatically. Contact admin if incorrect.</p>
            </div>

            <div>
                <label class="text-xs font-semibold text-navy">Email</label>
                <div class="mt-1 w-full border border-slate-200 bg-slate-50 rounded-lg px-3 py-2 text-sm text-slate-600 flex items-center justify-between">
                    <span>@Model.Email</span>
                    <i class="fa-solid fa-lock text-slate-400 text-xs" title="Contact admin to change"></i>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Contact the admin office to update this.</p>
            </div>

            <div>
                <label class="text-xs font-semibold text-navy">Faculty</label>
                <div class="mt-1 w-full border border-slate-200 bg-slate-50 rounded-lg px-3 py-2 text-sm text-slate-600 flex items-center justify-between">
                    <span>@(string.IsNullOrEmpty(Model.Faculty) ? "—" : Model.Faculty)</span>
                    <i class="fa-solid fa-lock text-slate-400 text-xs" title="Contact admin to change"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== EDITABLE PREFERENCES ===== -->
    <form asp-action="Profile" method="post" class="card mb-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-xs mb-3"></div>

        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
            <i class="fa-solid fa-user-pen mr-1"></i>Preferences
        </h2>

        <div class="space-y-4">
            <div>
                <label asp-for="PhoneNumber" class="text-xs font-semibold text-navy"></label>
                <input asp-for="PhoneNumber" type="tel" placeholder="+27 41 000 0000"
                       class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
                <span asp-validation-for="PhoneNumber" class="text-red-600 text-xs"></span>
            </div>

            <div>
                <label asp-for="Language" class="text-xs font-semibold text-navy"></label>
                <select asp-for="Language"
                        class="mt-1 w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold">
                    <option value="en">English</option>
                    <option value="af">Afrikaans</option>
                    <option value="xh">isiXhosa</option>
                    <option value="zu">isiZulu</option>
                </select>
            </div>

            <div class="space-y-2 pt-3 border-t border-slate-100">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="EmailNotifications" type="checkbox" class="rounded" />
                    <span class="text-sm text-slate-700">@Html.DisplayNameFor(m => m.EmailNotifications)</span>
                </label>

                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="PushNotifications" type="checkbox" class="rounded" />
                    <span class="text-sm text-slate-700">@Html.DisplayNameFor(m => m.PushNotifications)</span>
                </label>

                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="EventReminders" type="checkbox" class="rounded" />
                    <span class="text-sm text-slate-700">@Html.DisplayNameFor(m => m.EventReminders)</span>
                </label>

                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="DarkMode" type="checkbox" class="rounded" />
                    <span class="text-sm text-slate-700">@Html.DisplayNameFor(m => m.DarkMode)</span>
                </label>
            </div>
        </div>

        <div class="flex justify-end pt-4 mt-4 border-t border-slate-100">
            <button type="submit"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-6 py-2 rounded-xl text-sm transition">
                Save Changes
            </button>
        </div>
    </form>

    <!-- ===== PASSWORD ===== -->
    <div class="card">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="font-bold text-navy">Password</h2>
                <p class="text-xs text-slate-500 mt-0.5">Update your account password.</p>
            </div>
            <a asp-action="ChangePassword"
               class="bg-navy hover:bg-navy-light text-white font-bold px-4 py-2 rounded-xl text-sm transition">
                Change Password
            </a>
        </div>
    </div>
    @section Scripts {
        <script>
                (function() {
                    var checkbox = document.querySelector('input[name="DarkMode"]');
                    if (!checkbox) return;

                    checkbox.addEventListener('change', function() {
                        var theme = this.checked ? 'dark' : 'light';
                        document.documentElement.setAttribute('data-theme', theme);
                        localStorage.setItem('navguru-theme', theme);
                        document.cookie = 'navguru-theme=' + theme + '; path=/; max-age=31536000; samesite=lax';
                    });
                })();
        </script>
    }
</div>