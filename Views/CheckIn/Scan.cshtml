@{
    ViewData["Title"] = "Check In";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-navy">QR Check-In</h1>
        <p class="text-sm text-slate-500 mt-1">
            Point your camera at the event's QR code, or enter the manual code below.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl px-4 py-3 mb-4">
            <i class="fa-solid fa-circle-check mr-1"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3 mb-4">
            <i class="fa-solid fa-circle-exclamation mr-1"></i> @TempData["Error"]
        </div>
    }

    <!-- SCANNER -->
    <div class="card mb-4">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-bold text-navy">Camera Scanner</h2>
            <button id="startScanBtn"
                    class="bg-gold hover:bg-yellow-500 text-navy font-bold px-4 py-2 rounded-xl text-sm transition">
                <i class="fa-solid fa-camera mr-1"></i> Start Camera
            </button>
        </div>

        <div id="scanner-wrapper" class="hidden">
            <div id="reader" class="rounded-xl overflow-hidden bg-black aspect-square max-w-sm mx-auto"></div>
            <p class="text-xs text-slate-500 text-center mt-3">
                Hold the QR code steady within the frame.
            </p>
        </div>

        <div id="scanner-placeholder" class="text-center py-12">
            <i class="fa-solid fa-qrcode text-5xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-400">Camera is off.</p>
        </div>
    </div>

    <!-- RESULT -->
    <div id="result" class="hidden mb-4"></div>

    <!-- MANUAL CODE -->
    <div class="card">
        <h2 class="font-bold text-navy mb-3">Manual Code</h2>
        <p class="text-xs text-slate-500 mb-3">
            Ask the event organizer for the 32-character code shown next to the QR.
        </p>
        <form asp-controller="CheckIn" asp-action="ManualCode" method="post" class="flex gap-2">
            @Html.AntiForgeryToken()
            <input type="text" name="code" placeholder="Paste code here" required
                   class="flex-1 border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gold" />
            <button type="submit"
                    class="bg-navy text-white font-bold px-4 py-2 rounded-lg text-sm hover:bg-navy-light transition">
                Submit
            </button>
        </form>
    </div>

    <div class="mt-4 text-center">
        <a asp-controller="CheckIn" asp-action="History"
           class="text-xs font-semibold text-navy hover:text-gold-dark">
            View my check-in history <i class="fa-solid fa-arrow-right ml-1"></i>
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script>
        (function() {
            const startBtn = document.getElementById('startScanBtn');
            const placeholder = document.getElementById('scanner-placeholder');
            const wrapper = document.getElementById('scanner-wrapper');
            const resultBox = document.getElementById('result');
            const readerDiv = document.getElementById('reader');

            let video = null;
            let canvas = null;
            let stream = null;
            let scanning = false;
            let submitting = false;

            startBtn.addEventListener('click', async () => {
                if (scanning) {
                    stopScanning();
                    return;
                }

                try {
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'environment' }
                    });

                    placeholder.classList.add('hidden');
                    wrapper.classList.remove('hidden');

                    video = document.createElement('video');
                    video.setAttribute('playsinline', 'true');
                    video.setAttribute('autoplay', 'true');
                    video.setAttribute('muted', 'true');
                    video.style.width = '100%';
                    video.style.height = '100%';
                    video.style.objectFit = 'cover';

                    readerDiv.innerHTML = '';
                    readerDiv.appendChild(video);

                    video.srcObject = stream;
                    await video.play();

                    canvas = document.createElement('canvas');

                    scanning = true;
                    startBtn.innerHTML = '<i class="fa-solid fa-stop mr-1"></i> Stop Camera';

                    requestAnimationFrame(tick);
                } catch (err) {
                    showError('Camera unavailable: ' + err.message);
                }
            });

            function tick() {
                if (!scanning || !video || video.readyState !== video.HAVE_ENOUGH_DATA) {
                    if (scanning) requestAnimationFrame(tick);
                    return;
                }

                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(video, 0, 0);

                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: 'dontInvert'
                });

                if (code && code.data && !submitting) {
                    submitting = true;
                    submitPayload(code.data);
                    return;
                }

                if (scanning) requestAnimationFrame(tick);
            }

            function submitPayload(payload) {
                fetch('/CheckIn/Submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ payload })
                })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            showSuccess(data.message, data.alreadyCheckedIn);
                            stopScanning();
                        } else {
                            showError(data.message);
                            submitting = false;
                        }
                    })
                    .catch(err => {
                        showError('Network error: ' + err.message);
                        submitting = false;
                    });
            }

            function showSuccess(msg, already) {
                resultBox.className = 'mb-4 rounded-xl px-4 py-3 text-sm ' +
                    (already
                        ? 'bg-amber-50 border border-amber-200 text-amber-700'
                        : 'bg-green-50 border border-green-200 text-green-700');
                resultBox.innerHTML =
                    '<i class="fa-solid fa-circle-check mr-1"></i> ' + msg +
                    ' <a href="/CheckIn/History" class="underline ml-2 font-semibold">View history</a>';
                resultBox.classList.remove('hidden');
            }

            function showError(msg) {
                resultBox.className = 'mb-4 rounded-xl px-4 py-3 text-sm bg-red-50 border border-red-200 text-red-700';
                resultBox.innerHTML = '<i class="fa-solid fa-circle-exclamation mr-1"></i> ' + msg;
                resultBox.classList.remove('hidden');
            }

            function stopScanning() {
                scanning = false;
                submitting = false;

                if (stream) {
                    stream.getTracks().forEach(t => t.stop());
                    stream = null;
                }
                if (video) {
                    video.srcObject = null;
                    video = null;
                }
                readerDiv.innerHTML = '';
                wrapper.classList.add('hidden');
                placeholder.classList.remove('hidden');
                startBtn.innerHTML = '<i class="fa-solid fa-camera mr-1"></i> Start Camera';
            }
        })();
    </script>
}