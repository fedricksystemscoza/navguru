@model List<NavGuru.ViewModels.CheckInHistoryRow>
@{
    ViewData["Title"] = "My Check-Ins";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <a asp-controller="CheckIn" asp-action="Scan"
       class="text-xs font-semibold text-slate-500 hover:text-navy">
        <i class="fa-solid fa-arrow-left mr-1"></i> Back to scanner
    </a>

    <h1 class="text-2xl font-bold text-navy mt-3 mb-6">My Check-Ins</h1>

    @if (Model.Count == 0)
    {
        <div class="card text-center py-12">
            <i class="fa-solid fa-qrcode text-5xl text-slate-200 mb-3"></i>
            <p class="text-sm text-slate-400">No check-ins yet.</p>
            <a asp-action="Scan" class="inline-block mt-4 text-xs font-semibold text-navy hover:text-gold-dark">
                Scan an event QR <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var c in Model)
            {
                <div class="card flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-green-100 text-green-700 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-circle-check text-xl"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-navy truncate">@c.EventTitle</h3>
                            @if (c.IsMandatory)
                            {
                                <span class="badge badge-navy">Required</span>
                            }
                        </div>
                        <p class="text-xs text-slate-500 mt-1">
                            <i class="fa-solid fa-location-dot mr-1"></i>@c.Location
                            <span class="mx-1.5">·</span>
                            <i class="fa-solid fa-clock mr-1"></i>@c.CheckedInAt.ToLocalTime().ToString("ddd dd MMM, HH:mm")
                        </p>
                    </div>
                </div>
            }
        </div>
    }
</div>